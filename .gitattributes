# --- Unity YAML / data: text=auto --------------------------------------------
# Use text=auto, NOT text and NOT -text:
#   * `-text` would churn every CRLF-working-tree/LF-index file on the next add;
#   * forced `text` would corrupt binary-serialized assets such as TerrainData
#     .asset files (NUL-containing), which git must keep detecting as binary.
# text=auto normalizes genuine text while leaving detected-binary files alone.
*.meta           text=auto
*.unity          text=auto
*.prefab         text=auto
*.asset          text=auto
*.mat            text=auto
*.anim           text=auto
*.controller     text=auto
*.physicMaterial text=auto
*.physicsMaterial2D text=auto
*.asmdef         text=auto
*.asmref         text=auto
*.json           text=auto
*.yaml           text=auto
